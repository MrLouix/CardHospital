      ]
    }
  },
  "actions": [
    {
      "id": "admettre",
      "libelle": "Admettre",
      "motif": "admission",
      "precondition": "patient_hors_jeu",
      "phrase": "Admission de {patient}.",
      "effets": [
        {
          "effet": "admettre"
        }
      ]
    },
    {
      "id": "diagnostiquer",
      "libelle": "Diagnostiquer",
      "motif": "standard",
      "precondition": {
        "et": [
          "patient_en_jeu",
          {
            "non": {
              "combinaison": {
                "compte": {
                  "type": "salle",
                  "specialite": "recherche"
                },
                "min": 1
              }
            }
          }
        ]
      },
      "phrase": "Examen de {patient} par {medecin}[ et {medecin2}] dans {salle}[ avec {accessoire}].",
      "effets": [
        {
          "effet": "avancer_temps"
        },
        {
          "effet": "diagnostiquer"
        },
        {
          "effet": "payer",
          "valeur": "$recompenses.pieces_diagnostic"
        },
        {
          "effet": "aggraver"
        },
        {
          "effet": "si",
          "condition": "attente_depassee",
          "alors": [
            {
              "effet": "reputation",
              "valeur": "$recompenses.reputation_attente"
            }
          ]
        }
      ]
    },
    {
      "id": "traiter",
      "libelle": "Traiter",
      "motif": "standard",
      "precondition": {
        "et": [
          "patient_en_jeu",
          {
            "non": {
              "combinaison": {
                "compte": {
                  "type": "salle",
                  "specialite": "recherche"
                },
                "min": 1
              }
            }
          }
        ]
      },
      "phrase": "Tentative de soin de {patient} par {medecin}[ et {medecin2}] dans {salle}[ avec {accessoire}].",
      "effets": [
        {
          "effet": "avancer_temps"
        },
        {
          "effet": "si",
          "condition": "traitement_adapte",
          "alors": [
            {
              "effet": "soigner"
            },
            {
              "effet": "payer",
              "valeur": "$recompenses.pieces_traitement"
            },
            {
              "effet": "reputation",
              "valeur": "$recompenses.reputation_guerison"
            }
          ],
          "sinon": [
            {
              "effet": "si",
              "condition": "traitement_partiel",
              "alors": [
                {
                  "effet": "gagner_pv",
                  "valeur": {
                    "somme": [
                      "$recompenses.pv_partiel",
                      "$capacite.stabilisation"
                    ]
                  }
                },
                {
                  "effet": "payer",
                  "valeur": "$recompenses.pieces_partiel"
                }
              ],
              "sinon": [
                {
                  "effet": "perdre_pv",
                  "valeur": "$recompenses.pv_echec"
                },
                {
                  "effet": "reputation",
                  "valeur": "$recompenses.reputation_echec"
                }
              ]
            }
          ]
        },
        {
          "effet": "si",
          "condition": {
            "non": {
              "ou": [
                "gueri",
                "traitement_partiel"
              ]
            }
          },
          "alors": [
            {
              "effet": "aggraver"
            }
          ]
        },
        {
          "effet": "si",
          "condition": "attente_depassee",
          "alors": [
            {
              "effet": "reputation",
              "valeur": "$recompenses.reputation_attente"
            }
          ]
        }
      ]
    }
  ]
}
